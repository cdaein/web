---
// https://docs.astro.build/en/recipes/dynamically-importing-images/

// NOTE:
// - thumbnail for social
//   - use full url for image path: twitter doesn't support relative path
//   - becdause of this, the constructed image path is wrong when developing. ex. https://paperdove.com/@fs/..
//   - doens't really matter as i don't use it while dev, but something to note.

// really no need to use a separate package but..
// https://github.com/jonasmerlin/astro-seo

import { SEO } from "astro-seo";
import { site } from "@data/siteMetadata";
import { getCollection } from "astro:content";
import { parseCoverPath } from "@scripts/utils";

// title, description, id, slug
// ex.
// id: '2022/220309-nodes/index.mdx',
// slug: 'nodes',
const props = Astro.props;

const title = props.title ? `${props.title} • ${site.title}` : site.title;
const description = props.description || site.description;
// NOTE: "writing" post is not yet handled
const postType: "work" | "page" = props.postType;

// all images that sit next to content, keyed by source path. one glob for every
// collection: `cover` frontmatter is the single source of truth for a social image,
// so work and documentation need no separate handling.
// ex. '/src/content/work/2021/211006-nyt-wordlist/thumb.jpg'
const contentImagesObj = import.meta.glob<{ default: ImageMetadata }>(
  `/src/content/**/*.{png,jpg,jpeg,gif,webp}`,
);

// ex. default.src:
// '/@fs/Users/dane/Documents/GitHub/paperdove-2024/src/content/work/2022/220821-duet/thumb.png?origWidth=800&origHeight=800&origFormat=png',
// const allThumbs = await Astro.glob("@content/work/**/thumb*");

// fallback for the index and for posts without a usable `cover`: the newest work post.
// sorted by `date`, not by filename, so it follows what the site actually calls latest.
const [latestWorkPost] = (
  await getCollection("work", ({ data }) => {
    return import.meta.env.PROD ? data.published === true : true;
  })
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// one rule: a post's social image is its `cover`, resolved against its own directory.
// - post with a cover -> that image
// - post without one, and the index -> the latest work post's cover
// - pages -> default thumb
// - NOTE: consider each page has its own thumb. change page structure to have sub-directory.
const coverImage =
  postType === "page"
    ? undefined
    : (contentImagesObj[parseCoverPath(props.filePath, props.cover) ?? ""] ??
      contentImagesObj[
        parseCoverPath(latestWorkPost?.filePath, latestWorkPost?.data.cover) ??
          ""
      ]);

const cover = coverImage
  ? (await coverImage()).default.src
  : //  : (await pageThumbObj[`/thumb_default_page.png`]()).default.src;
    `/thumb_default_page.png`;
---

<head>
  <SEO
    charset="UTF-8"
    title={title}
    description={description}
    extend={{
      // extending the default link tags
      link: [
        // { rel: "icon", type: "image/svg+xml", href: "/favicon.svg" },
        { rel: "icon", href: "/favicon.ico" },
      ],
      // extending the default meta tags
      meta: [
        { httpEquiv: "x-ua-compatible", content: "ie-edge" },
        {
          name: "viewport",
          content: "width=device-width, initial-scale=1, shrink-to-fit=no",
        },
        // opengraph
        { name: "og:title", content: title },
        { name: "og:description", content: description },
        { name: "og:type", content: "website" },
        { name: "og:image", content: `${site.siteUrl}${cover}` },
        // twitter
        { name: "twitter:creator", content: site.author },
        { name: "twitter:title", content: title },
        { name: "twitter:description", content: description },
        { name: `twitter:card`, content: `summary_large_image` },
        { name: "twitter:image", content: `${site.siteUrl}${cover}` },
      ],
    }}
  />
  <meta name="viewport" content="width=device-width" />
  <meta name="generator" content={Astro.generator} />
  <link rel="me" href="https://genart.social/@daeinc" />
  <link
    rel="alternate"
    type="application/rss+xml"
    title={title}
    href={new URL("rss.xml", Astro.site)}
  />
</head>
<slot />
